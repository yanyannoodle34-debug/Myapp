<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <shape>
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="1"
                android:endY="1"
                android:angle="45">
                <item android:offset="0.0" android:color="@color/gradient_start" />
                <item android:offset="0.5" android:color="@color/gradient_center" />
                <item android:offset="1.0" android:color="@color/gradient_start" />
            </gradient>
            <corners android:radius="0dp" />
        </shape>
    </aapt:attr>
</animated-vector>
